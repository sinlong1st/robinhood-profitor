{
  "manifest_version": 3,
  "name": "Robinhood Profit Helper",
  "version": "0.1.1",
  "description": "Robinhood investing page helper",
  "permissions": ["storage"],
  "host_permissions": ["https://robinhood.com/account/investing*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Robinhood Profit Helper"
  },
  "content_scripts": [
    {
      "matches": ["https://robinhood.com/account/investing*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}