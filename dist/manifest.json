{
  "manifest_version": 3,
  "name": "Robinhood Profit Helper",
  "version": "0.2.0",
  "description": "Estimate selected total return on Robinhood investing page.",
  "permissions": ["storage"],
  "host_permissions": ["https://robinhood.com/*"],
  "content_scripts": [
    {
      "matches": ["https://robinhood.com/account/investing*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Robinhood Profit Helper"
  }
}